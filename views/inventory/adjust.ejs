<%- include('../partials/header') %>

<div class="page-header">
  <h1>Stock Adjustment</h1>
  <p>Manually adjust stock quantities with a reason</p>
</div>

<div class="card form-card">
  <% if (errors.length > 0) { %>
    <div class="alert alert-error">
      <% errors.forEach(e => { %><p><%= e.msg %></p><% }) %>
    </div>
  <% } %>

  <form method="POST" action="/inventory/adjust" class="form">
    <div class="form-group">
      <label for="product_id">Product *</label>
      <select id="product_id" name="product_id" required>
        <option value="">Select product</option>
        <% products.forEach(p => { %>
          <option value="<%= p.id %>" <%= form.product_id == p.id ? 'selected' : '' %>>
            <%= p.name %> (Current: <%= p.quantity %>)
          </option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="adjustment_quantity">Adjustment Quantity *</label>
      <input type="number" id="adjustment_quantity" name="adjustment_quantity"
             value="<%= form.adjustment_quantity || '' %>" required>
      <small class="text-muted">Use negative values to reduce stock (e.g. -10 for damaged products)</small>
    </div>
    <div class="form-group">
      <label for="reason">Reason for Adjustment *</label>
      <textarea id="reason" name="reason" rows="3" required><%= form.reason || '' %></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Apply Adjustment</button>
      <a href="/inventory" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
