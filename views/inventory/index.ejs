<%- include('../partials/header') %>

<div class="page-header flex-between">
  <div>
    <h1>Inventory</h1>
    <p>Real-time stock levels and monitoring</p>
  </div>
  <div class="action-links">
    <a href="/inventory/adjust" class="btn btn-primary">Stock Adjustment</a>
    <a href="/inventory/history" class="btn btn-outline">View History</a>
  </div>
</div>

<form method="GET" class="search-bar">
  <input type="text" name="search" value="<%= search %>" placeholder="Search inventory...">
  <button type="submit" class="btn btn-outline">Search</button>
</form>

<div class="card">
  <table class="table">
    <thead>
      <tr><th>Product</th><th>Category</th><th>Quantity</th><th>Reorder Level</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% products.forEach(p => { %>
        <tr class="<%= p.stock_status === 'out_of_stock' ? 'row-danger' : (p.stock_status === 'low_stock' ? 'row-warning' : '') %>">
          <td><%= p.name %></td>
          <td><%= p.category_name %></td>
          <td><%= p.quantity %></td>
          <td><%= p.reorder_level %></td>
          <td>
            <span class="badge badge-<%= p.stock_status === 'in_stock' ? 'active' : 'inactive' %>">
              <%= p.stock_status.replace('_', ' ') %>
            </span>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
