<%- include('../partials/header') %>

<div class="page-header flex-between">
  <div>
    <h1>Procurement</h1>
    <p>Stock received from suppliers</p>
  </div>
  <a href="/procurement/new" class="btn btn-primary">+ Record Procurement</a>
</div>

<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th>ID</th><th>Date</th><th>Product</th><th>Supplier</th>
        <th>Qty</th><th>Cost</th><th>Total</th><th>Branch</th><th>Recorded By</th>
      </tr>
    </thead>
    <tbody>
      <% procurements.forEach(p => { %>
        <tr>
          <td><%= p.id %></td>
          <td><%= new Date(p.received_date).toLocaleDateString() %></td>
          <td><%= p.product_name %></td>
          <td><%= p.supplier_name %></td>
          <td><%= p.quantity_received %></td>
          <td>KES <%= parseFloat(p.cost_price).toFixed(2) %></td>
          <td>KES <%= (p.quantity_received * parseFloat(p.cost_price)).toFixed(2) %></td>
          <td><%= p.branch_name %></td>
          <td><%= p.recorded_by_name %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
