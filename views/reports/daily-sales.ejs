<%- include('../partials/header') %>

<div class="page-header flex-between">
  <div>
    <h1>Daily Sales Report</h1>
    <p><%= new Date(date).toLocaleDateString() %></p>
  </div>
  <div class="action-links">
    <a href="/reports/daily-sales?date=<%= date %>&format=pdf" class="btn btn-outline">Download PDF</a>
    <a href="/reports" class="btn btn-outline">Back</a>
  </div>
</div>

<form method="GET" class="search-bar">
  <input type="date" name="date" value="<%= date %>">
  <button type="submit" class="btn btn-outline">Filter</button>
</form>

<div class="card">
  <table class="table">
    <thead><tr><th>Product</th><th>Qty Sold</th><th>Revenue (KES)</th></tr></thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.product_name %></td>
          <td><%= r.qty_sold %></td>
          <td><%= parseFloat(r.revenue).toFixed(2) %></td>
        </tr>
      <% }) %>
      <tr class="total-row">
        <td><strong>Total</strong></td>
        <td></td>
        <td><strong>KES <%= total.toFixed(2) %></strong></td>
      </tr>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
