<%- include('../partials/header') %>

<div class="page-header flex-between">
  <div><h1>Procurement Report</h1></div>
  <div class="action-links">
    <a href="/reports/procurement?format=pdf" class="btn btn-outline">Download PDF</a>
    <a href="/reports" class="btn btn-outline">Back</a>
  </div>
</div>

<div class="card">
  <table class="table">
    <thead>
      <tr><th>Date</th><th>Product</th><th>Supplier</th><th>Qty</th><th>Cost</th><th>Total (KES)</th></tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= new Date(r.received_date).toLocaleDateString() %></td>
          <td><%= r.product_name %></td>
          <td><%= r.supplier_name %></td>
          <td><%= r.quantity_received %></td>
          <td><%= parseFloat(r.cost_price).toFixed(2) %></td>
          <td><%= parseFloat(r.total_value).toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
