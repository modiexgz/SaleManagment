<%- include('../partials/header') %>

<div class="page-header">
  <h1>Director Dashboard</h1>
  <p>Company-wide performance overview</p>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <span class="stat-label">Total Company Sales</span>
    <span class="stat-value">KES <%= totalSales.toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Total Inventory Value</span>
    <span class="stat-value">KES <%= inventoryValue.toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Total Procurement Value</span>
    <span class="stat-value">KES <%= procurementValue.toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></span>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <h2>Top Selling Categories</h2>
    <table class="table">
      <thead><tr><th>Category</th><th>Revenue</th></tr></thead>
      <tbody>
        <% topCategories.forEach(c => { %>
          <tr><td><%= c.name %></td><td>KES <%= parseFloat(c.revenue).toFixed(2) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card">
    <h2>Top Selling Products</h2>
    <table class="table">
      <thead><tr><th>Product</th><th>Qty</th><th>Revenue</th></tr></thead>
      <tbody>
        <% topProducts.forEach(p => { %>
          <tr>
            <td><%= p.name %></td>
            <td><%= p.qty %></td>
            <td>KES <%= parseFloat(p.revenue).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>Quick Actions</h2>
  <div class="action-links">
    <a href="/reports/performance" class="btn btn-primary">View Performance Report</a>
    <a href="/reports/performance?format=pdf" class="btn btn-outline">Download PDF</a>
    <a href="/reports/inventory" class="btn btn-outline">Inventory Report</a>
    <a href="/reports/daily-sales" class="btn btn-outline">Daily Sales</a>
  </div>
</div>

<%- include('../partials/footer') %>
