<%- include('../partials/header') %>

<div class="page-header flex-between">
  <div>
    <h1>Notifications</h1>
    <p>Low stock and out-of-stock alerts</p>
  </div>
  <form method="POST" action="/notifications/read-all">
    <button type="submit" class="btn btn-outline">Mark All Read</button>
  </form>
</div>

<div class="card">
  <% if (notifications.length === 0) { %>
    <p class="text-muted">No notifications.</p>
  <% } else { %>
    <% notifications.forEach(n => { %>
      <div class="notification-item <%= n.type %> <%= n.is_read ? 'read' : '' %>">
        <div class="flex-between">
          <strong><%= n.type.replace(/_/g, ' ').toUpperCase() %></strong>
          <% if (!n.is_read) { %>
            <form method="POST" action="/notifications/<%= n.id %>/read">
              <button type="submit" class="btn btn-sm btn-outline">Mark Read</button>
            </form>
          <% } %>
        </div>
        <p><%= n.message %></p>
        <small><%= new Date(n.created_at).toLocaleString() %></small>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
