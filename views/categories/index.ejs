<%- include('../partials/header') %>

<div class="page-header flex-between">
  <div>
    <h1>Categories</h1>
    <p>Organize products into categories</p>
  </div>
  <a href="/categories/new" class="btn btn-primary">+ New Category</a>
</div>

<div class="card">
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Name</th><th>Description</th><th>Status</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% categories.forEach(c => { %>
        <tr>
          <td><%= c.id %></td>
          <td><%= c.name %></td>
          <td><%= c.description || '-' %></td>
          <td><span class="badge badge-<%= c.status %>"><%= c.status %></span></td>
          <td class="actions">
            <a href="/categories/<%= c.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
            <form method="POST" action="/categories/<%= c.id %>/toggle" style="display:inline">
              <button type="submit" class="btn btn-sm <%= c.status === 'active' ? 'btn-danger' : 'btn-success' %>">
                <%= c.status === 'active' ? 'Deactivate' : 'Activate' %>
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
