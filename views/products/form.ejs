<%- include('../partials/header') %>

<div class="page-header">
  <h1><%= product ? 'Edit Product' : 'New Product' %></h1>
</div>

<div class="card form-card">
  <% if (errors.length > 0) { %>
    <div class="alert alert-error">
      <% errors.forEach(e => { %><p><%= e.msg %></p><% }) %>
    </div>
  <% } %>

  <form method="POST" action="<%= product && product.id ? '/products/' + product.id : '/products' %>" class="form">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Product Name *</label>
        <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
      </div>
      <div class="form-group">
        <label for="category_id">Category *</label>
        <select id="category_id" name="category_id" required>
          <option value="">Select category</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= product && product.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="2"><%= product ? (product.description || '') : '' %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="cost_price">Cost Price (KES) *</label>
        <input type="number" id="cost_price" name="cost_price" step="0.01" min="0"
               value="<%= product ? product.cost_price : '0' %>" required>
      </div>
      <div class="form-group">
        <label for="selling_price">Selling Price (KES) *</label>
        <input type="number" id="selling_price" name="selling_price" step="0.01" min="0"
               value="<%= product ? product.selling_price : '0' %>" required>
      </div>
    </div>
    <div class="form-row">
      <% if (!product || !product.id) { %>
      <div class="form-group">
        <label for="quantity">Initial Quantity</label>
        <input type="number" id="quantity" name="quantity" min="0" value="<%= product ? product.quantity : '0' %>">
      </div>
      <% } %>
      <div class="form-group">
        <label for="reorder_level">Reorder Level</label>
        <input type="number" id="reorder_level" name="reorder_level" min="0"
               value="<%= product ? product.reorder_level : '10' %>">
      </div>
      <% if (product && product.id) { %>
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <% } %>
    </div>
    <div class="form-group">
      <label for="barcodes">Barcodes (comma-separated)</label>
      <input type="text" id="barcodes" name="barcodes" placeholder="e.g. 8901234567890, 8901234567891"
             value="<%= product ? (product.barcodes || '') : '' %>">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Product</button>
      <a href="/products" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
